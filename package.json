    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\""
  },
  "dependencies": {
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "vite-plugin-pwa": "^0.20.5",
    "typescript": "^5.5.4",
    "vue-tsc": "^2.0.29",
    "vite": "^5.4.1",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.4.1",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^9.27.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "prettier": "^3.3.3"
  }
