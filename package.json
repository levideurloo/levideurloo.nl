{
  "name": "levideurloo-portfolio",
  "version": "2.0.0",
  "description": "Portfolio website van Levi Deurloo — Vue 3 + Vite + TypeScript + Tailwind + SCSS, aurora dark/light theme.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
